    "配对已被拒绝，密钥未保存。请在服务器上重新运行 pair 后重试。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对已被拒绝，密钥未保存。请在服务器上重新运行 pair 后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing rejected; no secret was saved. Run pair again on the server."
          }
        }
      }
    },
    "配对超时。请在服务器上重新开启配对，并在 3 分钟内核对图案和数字。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对超时。请在服务器上重新开启配对，并在 3 分钟内核对图案和数字。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing timed out. Restart pairing on the server and compare the pattern and digits within 3 minutes."
          }
        }
      }
    },
    "配对连接失败或已断开。请确认地址、端口、防火墙，以及探针正在运行 -P。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对连接失败或已断开。请确认地址、端口、防火墙，以及探针正在运行 -P。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing connection failed or disconnected. Check the address, port, firewall and that the probe is running -P."
          }
        }
      }
    },
    "配对握手校验失败，未保存密钥。请勿忽略图案或数字不一致。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对握手校验失败，未保存密钥。请勿忽略图案或数字不一致。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing handshake verification failed; no secret was saved. Never ignore mismatched patterns or digits."
          }
        }
      }
    },
