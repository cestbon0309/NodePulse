    },
    "只连接你信任的地址。扫码不代表已验证身份，接下来仍须对照服务器终端上的图案和六位数字。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只连接你信任的地址。扫码不代表已验证身份，接下来仍须对照服务器终端上的图案和六位数字。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect only to addresses you trust. Scanning does not verify identity; you must still compare the pattern and six digits on the server terminal."
          }
        }
      }
    },
