            "state": "translated",
            "value": "未授权或握手失败，请检查管理公钥、密钥和探针时间；探针可能未启用 -A"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unauthorized or handshake failed. Check the admin public key, secret and probe clock; -A may not be enabled."
          }
        }
      }
    },
